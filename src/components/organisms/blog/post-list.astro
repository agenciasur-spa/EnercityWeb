---
import type { BlogPostWithCategory, BlogCategory } from '@/types/blog';

interface Props {
  posts: BlogPostWithCategory[];
  total: number;
  page: number;
  perPage: number;
  categories: BlogCategory[];
  activeCategorySlug?: string;
  queryText?: string;
  basePath: string;
}

const { posts, total, page, perPage, categories, activeCategorySlug, queryText, basePath } = Astro.props;

const totalPages = Math.max(1, Math.ceil(total / perPage));

function pageHref(targetPage: number): string {
  const params = new URLSearchParams();
  if (queryText) params.set('q', queryText);
  if (targetPage > 1) params.set('page', String(targetPage));
  const qs = params.toString();
  return qs ? `${basePath}?${qs}` : basePath;
}

function formatDate(iso: string | null): string {
  if (!iso) return '';
  return new Date(iso).toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<div class="container mx-auto max-w-6xl px-6 py-12">
  <form method="get" action={basePath} class="mb-8 flex gap-2">
    <input
      type="search"
      name="q"
      value={queryText}
      placeholder="Buscar noticias..."
      class="flex-1 rounded-full border border-gray-200 px-5 py-3 text-sm focus:border-[#F07E04] focus:outline-none"
    />
    <button
      type="submit"
      class="rounded-full bg-[#154660] px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-[#1d5a7a]"
    >
      Buscar
    </button>
  </form>

  <div class="mb-10 flex flex-wrap gap-2">
    <a
      href="/blog"
      class={`rounded-full px-4 py-2 text-sm font-medium transition-colors ${
        !activeCategorySlug ? 'bg-[#F07E04] text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
      }`}
    >
      Todas
    </a>
    {categories.map((c) => (
      <a
        href={`/blog/categoria/${c.slug}`}
        class={`rounded-full px-4 py-2 text-sm font-medium transition-colors ${
          activeCategorySlug === c.slug ? 'bg-[#F07E04] text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
        }`}
      >
        {c.name}
      </a>
    ))}
  </div>

  {posts.length === 0 ? (
    <div class="py-20 text-center">
      <p class="text-lg text-muted-foreground">No encontramos noticias con esos criterios.</p>
    </div>
  ) : (
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="group overflow-hidden rounded-2xl border bg-white shadow-sm transition-shadow hover:shadow-lg">
          <div class="aspect-video w-full overflow-hidden bg-gray-100">
            {post.cover_image_url && (
              <img
                src={post.cover_image_url}
                alt={post.title}
                class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            )}
          </div>
          <div class="p-5">
            {post.category && (
              <span class="mb-2 inline-block rounded-full bg-[#154660]/10 px-3 py-1 text-xs font-bold text-[#154660]">
                {post.category.name}
              </span>
            )}
            <h2 class="text-lg font-bold leading-snug text-[#154660] group-hover:text-[#F07E04]">
              {post.title}
            </h2>
            {post.excerpt && <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{post.excerpt}</p>}
            <p class="mt-3 text-xs text-muted-foreground">{formatDate(post.published_at)}</p>
          </div>
        </a>
      ))}
    </div>
  )}

  {totalPages > 1 && (
    <div class="mt-12 flex items-center justify-center gap-3">
      <a
        href={page > 1 ? pageHref(page - 1) : undefined}
        class={`rounded-full px-4 py-2 text-sm font-medium ${
          page > 1 ? 'bg-gray-100 text-gray-700 hover:bg-gray-200' : 'pointer-events-none bg-gray-50 text-gray-300'
        }`}
      >
        Anterior
      </a>
      <span class="text-sm text-muted-foreground">Página {page} de {totalPages}</span>
      <a
        href={page < totalPages ? pageHref(page + 1) : undefined}
        class={`rounded-full px-4 py-2 text-sm font-medium ${
          page < totalPages ? 'bg-gray-100 text-gray-700 hover:bg-gray-200' : 'pointer-events-none bg-gray-50 text-gray-300'
        }`}
      >
        Siguiente
      </a>
    </div>
  )}
</div>
