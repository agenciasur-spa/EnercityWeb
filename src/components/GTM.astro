---
/**
 * Google Tag Manager Component
 * 
 * GTM acts as a container for GA4, Google Ads, and other marketing tags.
 * Configure GA4 (G-XXXXX) and Google Ads (AW-XXXXX) from GTM dashboard.
 * 
 * Usage: Add this component to your layout
 */

// Hardcoded GTM ID (Vercel env variables not working with Astro adapter)
const gtmId = 'GTM-P7SGCGL4';

const gtmScript = `
(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${gtmId}');
`;
---

<!-- Google Tag Manager -->
<script is:inline set:html={gtmScript} />
<!-- End Google Tag Manager -->
