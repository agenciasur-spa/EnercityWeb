---
import AdminLayout from '@/layouts/admin-layout.astro';
import SettingsForm from '@/components/admin/settings-form';
import { supabaseAdmin } from '@/lib/supabase-admin';
import type { AdminSetting } from '@/types/admin';

const { data, error } = await supabaseAdmin
  .from('settings')
  .select('key, value, label')
  .order('key', { ascending: true });

if (error) {
  console.error('Error fetching settings:', error);
}

// Filter out dynamic limits (now derived from kit ranges)
const FILTERED_KEYS = ['limite_inferior', 'limite_superior'];
const settings = (data ?? []).filter((s: any) => !FILTERED_KEYS.includes(s.key)) as AdminSetting[];
---

<AdminLayout title="Configuración — Enercity Admin">
  <SettingsForm client:load settings={settings} />
</AdminLayout>