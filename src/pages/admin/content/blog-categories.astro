---
import AdminLayout from '@/layouts/admin-layout.astro';
import BlogCategoriesTable from '@/components/admin/content/blog-categories-table';
import { supabaseAdmin } from '@/lib/supabase-admin';

export const prerender = false;

const { data, error } = await supabaseAdmin
  .from('blog_categories')
  .select('*')
  .order('name', { ascending: true });

if (error) {
  console.error('[blog-categories.astro] Supabase query error:', error);
}

const categories = data ?? [];
---

<AdminLayout title="Categorías del Blog — Enercity Admin">
  <BlogCategoriesTable client:load categories={categories} />
</AdminLayout>
