---
import AdminLayout from '@/layouts/admin-layout.astro';
import ProyectosTable from '@/components/admin/content/proyectos-table';
import { supabaseAdmin } from '@/lib/supabase-admin';

export const prerender = false;

const { data, error } = await supabaseAdmin
  .from('proyectos')
  .select('*')
  .order('orden', { ascending: true });

if (error) {
  console.error('[proyectos.astro] Supabase query error:', error);
}

const proyectos = data ?? [];
---

<AdminLayout title="Proyectos Detallados — Enercity Admin">
  <ProyectosTable client:load proyectos={proyectos} />
</AdminLayout>
