---
import AdminLayout from '@/layouts/admin-layout.astro';
import SectionsEditor from '@/components/admin/content/sections-editor';
import { supabaseAdmin } from '@/lib/supabase-admin';

export const prerender = false;

const { data, error } = await supabaseAdmin
  .from('site_content')
  .select('*')
  .in('section', [
    'empresas_hero',
    'empresas_cost_problem',
    'empresas_value_prop',
    'empresas_benefit_cards',
    'empresas_process',
    'empresas_whats_included',
    'empresas_contact',
  ])
  .order('section', { ascending: true });

if (error) {
  console.error('[empresas-sections.astro] Supabase query error:', error);
}

type SiteContentRow = {
  id: string;
  section: string;
  data: Record<string, unknown>;
  updated_at: string;
};

const sections = (data ?? []) as unknown as SiteContentRow[];
---

<AdminLayout title="Secciones Empresas — Enercity Admin">
  <SectionsEditor client:load sections={sections} sectionFilter="empresas" />
</AdminLayout>
