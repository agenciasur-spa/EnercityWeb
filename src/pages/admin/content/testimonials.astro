---
import AdminLayout from '@/layouts/admin-layout.astro';
import TestimonialsTable from '@/components/admin/content/testimonials-table';
import { supabaseAdmin } from '@/lib/supabase-admin';

export const prerender = false;

const { data, error } = await supabaseAdmin
  .from('testimonials')
  .select('*')
  .order('sort_order', { ascending: true });

if (error) {
  console.error('[testimonials.astro] Supabase query error:', error);
}

const testimonials = data ?? [];
---

<AdminLayout title="Testimonios — Enercity Admin">
  <TestimonialsTable client:load testimonials={testimonials} />
</AdminLayout>
