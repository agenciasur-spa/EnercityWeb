---
import AdminLayout from '@/layouts/admin-layout.astro';
import DispatchCostsTable from '@/components/admin/dispatch-costs-table';
import { supabaseAdmin } from '@/lib/supabase-admin';

export const prerender = false;

const { data, error } = await supabaseAdmin
  .from('region_dispatch_costs')
  .select('id, region, dispatch_cost')
  .order('region', { ascending: true });

if (error) {
  console.error('[dispatch-costs.astro] Supabase query error:', error);
}

const regions = data ?? [];
---

<AdminLayout title="Costo de Despacho — Enercity Admin">
  <DispatchCostsTable client:load initialRegions={regions} />
</AdminLayout>