---
import AdminLayout from '@/layouts/admin-layout.astro';
import BatteryTable from '@/components/admin/battery-table';
import { supabaseAdmin } from '@/lib/supabase-admin';

export const prerender = false;

const { data, error } = await supabaseAdmin
  .from('almacenamiento_baterias')
  .select('*')
  .eq('activo', true)
  .single();

if (error) {
  console.error('[bateria.astro] Supabase query error:', error);
}

const battery = data ?? null;
---

<AdminLayout title="Batería Híbrida — Enercity Admin">
  <BatteryTable client:load initialBattery={battery} />
</AdminLayout>