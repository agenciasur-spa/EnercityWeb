---
import Layout from '../../layouts/layout.astro';
import { Navbar } from '../../components/organisms/navbar';
import { Footer } from '../../components/organisms/footer';
import { getNavLinks, getFooterContent, getPostBySlug, getRelatedPosts } from '../../lib/content';
import { renderMarkdown } from '../../lib/markdown';
import type { NavLink } from '../../types/content';

export const prerender = false;

const { slug } = Astro.params;

const [navbarLinks, footerLinks, footerContent] = await Promise.all([
  getNavLinks('navbar'),
  getNavLinks('footer'),
  getFooterContent(),
]);

const post = await getPostBySlug(slug!);

if (!post) {
  return Astro.redirect('/blog');
}

const relatedPosts = await getRelatedPosts(post.id, post.category_id);

const siteUrl =
  import.meta.env.PUBLIC_SITE_URL ||
  (typeof import.meta.env.VERCEL_PROJECT_PRODUCTION_URL === 'string'
    ? `https://${import.meta.env.VERCEL_PROJECT_PRODUCTION_URL}`
    : typeof import.meta.env.VERCEL_URL === 'string'
      ? `https://${import.meta.env.VERCEL_URL}`
      : 'http://localhost:4321');

const pageUrl = `${siteUrl}/blog/${post.slug}`;
const seoTitle = `${post.title} | Blog Enercity`;
const seoDescription = post.excerpt ?? post.title;

const contentHtml = renderMarkdown(post.content);

function formatDate(iso: string | null): string {
  if (!iso) return '';
  return new Date(iso).toLocaleDateString('es-CL', { year: 'numeric', month: 'long', day: 'numeric' });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog` },
        { '@type': 'ListItem', position: 3, name: post.title, item: pageUrl },
      ],
    },
    {
      '@type': 'BlogPosting',
      '@id': `${pageUrl}#post`,
      headline: post.title,
      description: post.excerpt ?? undefined,
      image: post.cover_image_url ?? undefined,
      datePublished: post.published_at ?? undefined,
      dateModified: post.updated_at,
      author: post.author_name ? { '@type': 'Person', name: post.author_name } : { '@type': 'Organization', name: 'Enercity' },
      publisher: { '@type': 'Organization', name: 'Enercity' },
      mainEntityOfPage: pageUrl,
    },
  ],
};
---

<Layout title={seoTitle} description={seoDescription} ogImage={post.cover_image_url ?? undefined}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Navbar client:load isHome={false} links={navbarLinks.filter((l: NavLink) => l.label !== 'Simulador')} />

  <main>
    <section class="relative flex min-h-[45vh] w-full items-end overflow-hidden bg-[#0A1929]">
      {post.cover_image_url && (
        <div class="absolute inset-0 z-0">
          <img
            src={post.cover_image_url}
            alt={post.title}
            class="size-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-[#0A1929]/60 mix-blend-multiply"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-[#0A1929] via-[#0A1929]/30 to-transparent"></div>
        </div>
      )}

      <div class="container relative z-10 mx-auto px-6 pb-10 pt-32">
        <nav class="mb-6 flex flex-wrap items-center gap-2 text-sm text-white/60">
          <a href="/" class="hover:text-[#F07E04]">Inicio</a>
          <span>/</span>
          <a href="/blog" class="hover:text-[#F07E04]">Blog</a>
          {post.category && (
            <>
              <span>/</span>
              <a href={`/blog/categoria/${post.category.slug}`} class="hover:text-[#F07E04]">{post.category.name}</a>
            </>
          )}
        </nav>

        <h1 class="max-w-3xl text-3xl font-bold leading-tight text-white drop-shadow-2xl md:text-5xl">
          {post.title}
        </h1>

        <p class="mt-4 text-sm text-white/70">
          {post.author_name && <span>{post.author_name} · </span>}
          {formatDate(post.published_at)}
        </p>
      </div>
    </section>

    <div class="container mx-auto max-w-3xl px-6 py-12">
      <article class="article-content" set:html={contentHtml} />
    </div>

    {relatedPosts.length > 0 && (
      <section class="border-t bg-gray-50 py-16">
        <div class="container mx-auto max-w-6xl px-6">
          <h2 class="mb-8 text-2xl font-bold text-[#154660]">Noticias relacionadas</h2>
          <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {relatedPosts.map((related) => (
              <a href={`/blog/${related.slug}`} class="group overflow-hidden rounded-2xl border bg-white shadow-sm transition-shadow hover:shadow-lg">
                <div class="aspect-video w-full overflow-hidden bg-gray-100">
                  {related.cover_image_url && (
                    <img
                      src={related.cover_image_url}
                      alt={related.title}
                      class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  )}
                </div>
                <div class="p-5">
                  <h3 class="text-lg font-bold leading-snug text-[#154660] group-hover:text-[#F07E04]">
                    {related.title}
                  </h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer client:visible links={footerLinks} content={footerContent} />
</Layout>

<style>
  .article-content {
    color: #374151;
    line-height: 1.8;
    font-size: 1.0625rem;
  }
  .article-content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: #154660;
  }
  .article-content :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: #154660;
  }
  .article-content :global(p) {
    margin-bottom: 1.25rem;
  }
  .article-content :global(a) {
    color: #F07E04;
    text-decoration: underline;
  }
  .article-content :global(img) {
    margin: 1.5rem 0;
    border-radius: 1rem;
    max-width: 100%;
  }
  .article-content :global(ul),
  .article-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }
  .article-content :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 4px solid #F07E04;
    color: #6b7280;
    font-style: italic;
  }
</style>
