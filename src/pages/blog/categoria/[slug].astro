---
import Layout from '../../../layouts/layout.astro';
import { Navbar } from '../../../components/organisms/navbar';
import { Footer } from '../../../components/organisms/footer';
import PostList from '../../../components/organisms/blog/post-list.astro';
import { getNavLinks, getFooterContent, getPublishedPosts, getBlogCategories } from '../../../lib/content';
import type { NavLink } from '../../../types/content';

export const prerender = false;

const PER_PAGE = 12;
const { slug } = Astro.params;

const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const queryText = Astro.url.searchParams.get('q')?.trim() || undefined;

const [navbarLinks, footerLinks, footerContent, categories] = await Promise.all([
  getNavLinks('navbar'),
  getNavLinks('footer'),
  getFooterContent(),
  getBlogCategories(),
]);

const category = categories.find((c) => c.slug === slug);

if (!category) {
  return Astro.redirect('/blog');
}

const { posts, total } = await getPublishedPosts({
  page,
  perPage: PER_PAGE,
  categorySlug: category.slug,
  query: queryText,
});

const seoTitle = `${category.name} | Blog Enercity`;
const seoDescription = `Noticias de la categoría ${category.name} en el blog de Enercity.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <Navbar client:load isHome={false} links={navbarLinks.filter((l: NavLink) => l.label !== 'Simulador')} />

  <main>
    <section class="bg-[#0A1929] pt-32 pb-16">
      <div class="container mx-auto px-6">
        <nav class="mb-4 flex items-center gap-2 text-sm text-white/60">
          <a href="/blog" class="hover:text-[#F07E04]">Blog</a>
          <span>/</span>
          <span class="font-medium text-white">{category.name}</span>
        </nav>
        <h1 class="text-4xl font-bold text-white md:text-5xl">{category.name}</h1>
      </div>
    </section>

    <PostList
      posts={posts}
      total={total}
      page={page}
      perPage={PER_PAGE}
      categories={categories}
      activeCategorySlug={category.slug}
      queryText={queryText}
      basePath={`/blog/categoria/${category.slug}`}
    />
  </main>

  <Footer client:visible links={footerLinks} content={footerContent} />
</Layout>
